// Shared model colour evaluation for rasterization and native ray materials.
// The calibrated wrapper defines STARFOX_CALIBRATED_PALETTE and its integer
// palette equations; headset rendering keeps its established approximations.
vec4 scene_styled_colour(vec4 colour,uvec4 effects) {
#if defined(STARFOX_CALIBRATED_PALETTE)
    vec4 palette_colour;
    if(calibrated_palette_colour(colour,effects,palette_colour)) return palette_colour;
#endif
    uint style=effects.x;
    if(style==0 || effects.y==0) return colour;
    vec3 rgb=colour.rgb,result=rgb;
    float light=dot(rgb,vec3(77,150,29))/256;
    if(style==1) {
        float peak=max(max(rgb.r,rgb.g),max(rgb.b,1./255));
        result=rgb*(min(1.,floor(peak*5.+.5)/5.)/peak);
    }
    else if(style==4) result=vec3(light);
    else if(style==8) result=saturate(vec3(dot(rgb,vec3(101,197,48)),
        dot(rgb,vec3(89,176,43)),dot(rgb,vec3(70,137,34)))/256);
    else if(style==9) {
        const vec3 palette[5]=vec3[5](vec3(8,5,40),vec3(65,20,150),vec3(220,30,70),
            vec3(255,150,15),vec3(255,255,210));
        float value=light*255/64;uint band=min(uint(value),3U);
        result=mix(palette[band],palette[band+1],value-band)/255;
    } else if(style==10) result=saturate(vec3(light/7,24./255+light*1.2,light/4));
    else if(style==11) result=96./255+rgb*5/8;
    else if(style==13) result=mix(vec3(55,8,100),vec3(70,250,245),light)/255;
    else if(style==14) result=floor(saturate(rgb)*5+.5)/5;
    else if(style==15) result=mix(vec3(8,24,65),vec3(224,250,246),light)/255;
    else if(style==16) {
        vec3 contrast=rgb*rgb*(3-2*rgb);
        result=saturate(contrast*vec3(1.06,1.,.87)+vec3(.035,.015,.025));
    }
    return vec4(mix(rgb,result,min(effects.y,100U)/100.),colour.a);
}
