include_guard(GLOBAL)

function(starfox_add_desktop_icon target)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    if(WIN32 AND NOT WINDOWS_STORE)
        enable_language(RC)
        # PCVR and non-embedded builds need the executable icon as well.
        set(icon "${root}/assets/icons/starfox-enhanced.ico")
        file(TO_CMAKE_PATH "${icon}" icon)
        set(rc "${CMAKE_CURRENT_BINARY_DIR}/${target}_icon.rc")
        file(CONFIGURE OUTPUT "${rc}" CONTENT "1 ICON \"@icon@\"\n" @ONLY)
        # Isolate windres from SDL's large public include-directory list.
        add_library(${target}_icon OBJECT "${rc}")
        target_sources(${target} PRIVATE $<TARGET_OBJECTS:${target}_icon>)
        add_dependencies(${target} ${target}_icon)
        set_property(SOURCE "${rc}" APPEND PROPERTY OBJECT_DEPENDS "${icon}")
    elseif(APPLE AND NOT IOS)
        set(icon "${root}/assets/icons/starfox-enhanced.icns")
        target_sources(${target} PRIVATE "${icon}")
        set_source_files_properties("${icon}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
        set_target_properties(${target} PROPERTIES MACOSX_BUNDLE_ICON_FILE starfox-enhanced.icns)
        set(STARFOX_APPLE_ICON_PLIST "<key>CFBundleIconFile</key><string>starfox-enhanced.icns</string>" PARENT_SCOPE)
    elseif(UNIX AND NOT ANDROID AND NOT SWITCH AND NOT VITA AND NOT STARFOX_PS5)
        set(component Unspecified)
        if(target STREQUAL "starfox_pcvr")
            set(component pcvr)
        elseif(target STREQUAL "starfox_steamframe")
            set(component steamframe)
        endif()
        install(FILES "${root}/assets/icons/source.png" DESTINATION .
            RENAME starfox-enhanced.png COMPONENT ${component})
    endif()
endfunction()
