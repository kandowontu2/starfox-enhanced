# File identity is not Authenticode signing and is not an antivirus exemption.
include_guard(GLOBAL)
if(WIN32 AND NOT WINDOWS_STORE)
    enable_language(RC)
endif()

function(starfox_windows_metadata target description)
    if(NOT WIN32 OR WINDOWS_STORE OR NOT TARGET "${target}")
        return()
    endif()
    get_target_property(already_applied "${target}" STARFOX_WINDOWS_METADATA)
    if(already_applied)
        return()
    endif()
    set(STARFOX_WINDOWS_VERSION "${PROJECT_VERSION}")
    # The optional adapters are separate CMake projects without their own
    # release version. Use the repository version, not an invented SDK version.
    if(STARFOX_WINDOWS_VERSION STREQUAL "")
        file(STRINGS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../CMakeLists.txt"
            version_line REGEX "^project\\(starfox_enhanced VERSION [0-9.]+ ")
        string(REGEX MATCH "VERSION ([0-9.]+)" version_match "${version_line}")
        set(STARFOX_WINDOWS_VERSION "${CMAKE_MATCH_1}")
    endif()
    if(NOT STARFOX_WINDOWS_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
        message(FATAL_ERROR "Invalid Windows file version: ${STARFOX_WINDOWS_VERSION}")
    endif()
    string(REPLACE "." ";" version_parts "${STARFOX_WINDOWS_VERSION}")
    list(LENGTH version_parts version_count)
    if(version_count EQUAL 3)
        list(APPEND version_parts 0)
    endif()
    foreach(part IN LISTS version_parts)
        if(part GREATER 65535)
            message(FATAL_ERROR "Windows version components must fit in 16 bits")
        endif()
    endforeach()
    list(JOIN version_parts "," STARFOX_WINDOWS_FIXED_VERSION)
    set(STARFOX_WINDOWS_DESCRIPTION "${description}")
    set(STARFOX_WINDOWS_INTERNAL_NAME "${target}")
    get_target_property(output_name "${target}" OUTPUT_NAME)
    if(NOT output_name)
        set(output_name "${target}")
    endif()
    get_target_property(target_type "${target}" TYPE)
    if(target_type STREQUAL "SHARED_LIBRARY" OR target_type STREQUAL "MODULE_LIBRARY")
        set(STARFOX_WINDOWS_FILE_TYPE VFT_DLL)
        get_target_property(output_prefix "${target}" PREFIX)
        if(output_prefix STREQUAL "output_prefix-NOTFOUND")
            set(output_prefix "${CMAKE_SHARED_LIBRARY_PREFIX}")
        endif()
        set(STARFOX_WINDOWS_FILENAME "${output_prefix}${output_name}${CMAKE_SHARED_LIBRARY_SUFFIX}")
    else()
        set(STARFOX_WINDOWS_FILE_TYPE VFT_APP)
        set(STARFOX_WINDOWS_FILENAME "${output_name}.exe")
    endif()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/windows_version.rc.in"
        "${CMAKE_CURRENT_BINARY_DIR}/${target}_version.rc" @ONLY)
    target_sources("${target}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${target}_version.rc")
    # MSVC supplies its normal asInvoker manifest. MinGW does not; supply the
    # same ordinary-user contract without requesting elevation or uiAccess.
    if(MINGW AND target_type STREQUAL "EXECUTABLE")
        file(TO_CMAKE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/windows_application.manifest"
            STARFOX_WINDOWS_MANIFEST)
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/windows_application.rc.in"
            "${CMAKE_CURRENT_BINARY_DIR}/${target}_manifest.rc" @ONLY)
        target_sources("${target}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${target}_manifest.rc")
    endif()
    set_property(TARGET "${target}" PROPERTY STARFOX_WINDOWS_METADATA TRUE)
endfunction()
